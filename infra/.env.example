# ─────────────────────────────────────────────────────────────────────
# Superset MCP Agent — deployment configuration
# Copy to `.env` (cp .env.example .env) and fill in the secrets.
# The app loads these via python-dotenv; docker-compose injects them too.
# ─────────────────────────────────────────────────────────────────────

# ── REQUIRED secrets ─────────────────────────────────────────────────
# LLM API key: an OpenAI key, or an Amazon Bedrock API key for Bedrock Mantle
OPENAI_API_KEY=sk-REPLACE_ME

# Bearer token for the hosted Superset MCP service
MCP_AUTH_TOKEN=REPLACE_WITH_MCP_JWT

SUPERSET_BASE_URL=https://dashboard.idx-ng.com
# The pipeline talks to Superset via MCP, so the health-check REST login is
# optional (keep false for SSO-only Superset).
SUPERSET_LOGIN_ENABLED=false
# BUT: to register created dashboards for embedding (so the inline preview loads),
# the agent calls Superset's REST API — set these to a WORKING db-provider service
# account (the same kind your guest-token middleware uses). admin/admin won't work
# on an SSO Superset. If left non-working, dashboards still build but won't preview inline.
SUPERSET_USERNAME=REPLACE_WITH_SERVICE_ACCOUNT
SUPERSET_PASSWORD=REPLACE_ME
# Inline dashboard embedding
SUPERSET_EMBED_REGISTER=true
# Domains allowed to embed (comma-separated; empty = any)
SUPERSET_EMBED_ALLOWED_DOMAINS=

# ── Web UI ───────────────────────────────────────────────────────────
# Sub-path the UI is served under behind the reverse proxy. For
# https://dashboard.idx-ng.com/chatbot set this to /chatbot. Empty = root.
APP_BASE_PATH=/chatbot

# ── MCP service ──────────────────────────────────────────────────────
MCP_URL=https://dashboard.idx-ng.com/mcp

# ── LLM ──────────────────────────────────────────────────────────────
# OpenAI by default. To use GPT-5.6 Luna on Amazon Bedrock Mantle (us-east-1),
# put the Bedrock API key in OPENAI_API_KEY above and set:
#   LLM_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
#   LLM_MODEL=openai.gpt-5.6-luna
#   OPENAI_PROJECT_ID=proj_REPLACE_ME   (optional; omit for the default project)
LLM_MODEL=gpt-5.5

# ── Keycloak (web UI auth) ───────────────────────────────────────────
# Defaults match the shared ui-cbn client. The app's public origin MUST be
# registered in this client's Valid Redirect URIs + Web Origins in Keycloak.
KEYCLOAK_ENABLED=true
KEYCLOAK_URL=https://keycloak.idx-ng.com/auth
KEYCLOAK_REALM=cbn
KEYCLOAK_CLIENT_ID=angular-client
# Optional: restrict access to holders of a specific realm role (empty = any authenticated user)
KEYCLOAK_REQUIRED_ROLE=
